PORT=8081
NODE_ENV=development

# Supabase project settings -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Server-only. NEVER ship this to the React Native app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: JWT secret used for symmetric (HS256) validation of Supabase access
# tokens. Leave blank if you use asymmetric JWKS (recommended).
SUPABASE_JWT_SECRET=

# Comma separated list of allowed origins for the React Native app / admin tools
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Deep link the password-reset email should open in the React Native app
PASSWORD_RESET_REDIRECT_TO=homeone://reset-password

# Auth behaviour
AUTH_OTP_CHANNEL=email
AUTH_OTP_LENGTH=6
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60

# Uploads
UPLOAD_MAX_IMAGE_BYTES=5242880
UPLOAD_MAX_DOCUMENT_BYTES=10485760