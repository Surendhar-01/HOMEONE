PORT=8081
NODE_ENV=development

# Supabase project settings -> Project Settings -> API
SUPABASE_URL=

SUPABASE_PUBLISHABLE_KEY=

# Server-only. NEVER ship this to the React Native app.
SUPABASE_SERVICE_ROLE_KEY=

# Only needed for projects still signing tokens with HS256.
SUPABASE_JWT_SECRET=

# PostgreSQL connection string, used only by scripts/db-migrate.ts.
# The direct host (db.<ref>.supabase.co) is IPv6-only, so prefer the IPv4 pooler:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Deep link the password-reset email should open in the React Native app
PASSWORD_RESET_REDIRECT_TO=homeone://reset-password

# Auth behaviour
AUTH_OTP_CHANNEL=email
AUTH_OTP_LENGTH=6
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60

# Uploads
UPLOAD_MAX_IMAGE_BYTES=5242880
UPLOAD_MAX_DOCUMENT_BYTES=10485760